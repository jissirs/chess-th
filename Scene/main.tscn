[sub_resource type="Shader" id="Shader_hud_clear"]
code = "shader_type canvas_item;
uniform vec2 center = vec2(0.5, 0.49);
uniform vec2 half_size = vec2(0.412, 0.224);
uniform float bevel_sum = 0.595;
void fragment() {
    vec2 q = abs(UV - center);
    float inside = step(q.x, half_size.x) * step(q.y, half_size.y) * step(q.x + q.y, bevel_sum);
    COLOR.a *= 1.0 - inside;
}
"

